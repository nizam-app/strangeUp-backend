# Copy to `.env` for local development (never commit real secrets).

NODE_ENV=development
PORT=3000

# PostgreSQL connection string (dev). Neon is the recommended local topology.
# Use isolated catalogs: strangeup_dev (this URL) and strangeup_test (integration).
# Runtime may use the Neon pooler host; migrations use a direct (non-pooler) host.
# - Neon: postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/strangeup_dev?sslmode=require
# - Local Postgres fallback: postgresql://strangeup:strangeup@localhost:5432/strangeup_dev?schema=public
# - Prisma Dev fallback (`npm run db:dev`): use the DATABASE_URL printed by `prisma dev`
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/strangeup_dev?sslmode=require

# Comma-separated allowed browser origins (no wildcard when credentials are enabled)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LOG_LEVEL=info
JSON_BODY_LIMIT=100kb
TRUST_PROXY=false

# Auth (Task 002B.1) — generate a strong random secret for non-test environments
JWT_ACCESS_SECRET=change-me-to-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_CHALLENGE_TTL_SECONDS=86400
AUTH_RATE_LIMIT_LOGIN_PER_IP=10
AUTH_RATE_LIMIT_LOGIN_PER_EMAIL=5
AUTH_RATE_LIMIT_REGISTER_PER_IP=10
AUTH_RATE_LIMIT_PASSWORD_RESET_PER_IP=10
AUTH_RATE_LIMIT_PASSWORD_RESET_PER_EMAIL=5
AUTH_RATE_LIMIT_EMAIL_VERIFY_PER_USER=5
AUTH_RATE_LIMIT_PASSWORD_CHANGE_PER_IP=10
AUTH_RATE_LIMIT_PASSWORD_CHANGE_PER_USER=5

# Optional trusted base URL for password-reset links in dev/stub email (never use Host header)
# PUBLIC_APP_BASE_URL=https://app.example.com

# Profile avatar uploads (local disk; dev only until cloud storage is approved)
PROFILE_UPLOAD_DIR=.data/profile-media
ACTIVITY_UPLOAD_DIR=.data/activity-media
GROUP_UPLOAD_DIR=.data/group-media

# RELEASE BLOCKER: counsel-approved consent document version IDs are not configured server-side yet.
# Clients must send non-empty version strings per consent item until canonical versions are published.

# Integration tests — must be catalog strangeup_test (never strangeup_dev, neondb, or production)
# RUN_INTEGRATION=1
# INTEGRATION_DATABASE_URL=postgresql://USER:PASSWORD@ep-yyyy-pooler.REGION.aws.neon.tech/strangeup_test?sslmode=require
