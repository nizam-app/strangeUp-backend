# Copy to `.env` for local development (never commit real secrets).
#
# Production (NODE_ENV=production): server refuses to start unless JWT is strong,
# PUBLIC_APP_BASE_URL is set, CORS has no localhost, upload dirs are not `.data/*`,
# GROUP_COMMUNITY_INTERACTIVE_ENABLED=false (D-06), and KYC_PROVIDER_ENABLED=false
# until a vendor integration is approved.

NODE_ENV=development
PORT=3000

# PostgreSQL connection string (dev). Neon is the recommended local topology.
# Use isolated catalogs: strangeup_dev (this URL) and strangeup_test (integration).
# Runtime may use the Neon pooler host; migrations use a direct (non-pooler) host.
# - Neon: postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/strangeup_dev?sslmode=require
# - Local Postgres fallback: postgresql://strangeup:strangeup@localhost:5432/strangeup_dev?schema=public
# - Prisma Dev fallback (`npm run db:dev`): use the DATABASE_URL printed by `prisma dev`
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/strangeup_dev?sslmode=require

# Comma-separated allowed browser origins (no wildcard when credentials are enabled)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LOG_LEVEL=info
JSON_BODY_LIMIT=100kb
TRUST_PROXY=false

# Auth (Task 002B.1) — generate a strong random secret for non-test environments
JWT_ACCESS_SECRET=change-me-to-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_CHALLENGE_TTL_SECONDS=86400
AUTH_RATE_LIMIT_LOGIN_PER_IP=10
AUTH_RATE_LIMIT_LOGIN_PER_EMAIL=5
AUTH_RATE_LIMIT_REGISTER_PER_IP=10
AUTH_RATE_LIMIT_PASSWORD_RESET_PER_IP=10
AUTH_RATE_LIMIT_PASSWORD_RESET_PER_EMAIL=5
AUTH_RATE_LIMIT_EMAIL_VERIFY_PER_USER=5
AUTH_RATE_LIMIT_PASSWORD_CHANGE_PER_IP=10
AUTH_RATE_LIMIT_PASSWORD_CHANGE_PER_USER=5
AUTH_RATE_LIMIT_EMAIL_CHANGE_PER_IP=10
AUTH_RATE_LIMIT_EMAIL_CHANGE_PER_USER=5

# Trusted base URL for auth email links (required in production; optional in dev)
# PUBLIC_APP_BASE_URL=https://app.example.com

# Task 019/019B — transactional email (Resend adapter; default dev_stub — no live sends in CI)
# TRANSACTIONAL_EMAIL_MODE=dev_stub   # local default; forbidden when NODE_ENV=production
# TRANSACTIONAL_EMAIL_MODE=disabled   # production fail-closed
# TRANSACTIONAL_EMAIL_MODE=provider   # requires RESEND_API_KEY + TRANSACTIONAL_EMAIL_FROM + PUBLIC_APP_BASE_URL
# RESEND_API_KEY=
# TRANSACTIONAL_EMAIL_FROM=noreply@your-verified-domain.example
# RESEND_REQUEST_TIMEOUT_MS=10000
# RESEND_MAX_RETRIES=2
# Optional one-recipient smoke (never enabled in CI): RESEND_SMOKE_TEST=1 RESEND_SMOKE_TO=you@verified-domain.example

# Task 019/019B — distributed abuse protection (Upstash Redis via rediss:// TCP)
# RATE_LIMIT_STORE=memory              # dev/test default; forbidden in production
# RATE_LIMIT_STORE=fail_closed         # production until Redis URL configured
# RATE_LIMIT_STORE=redis               # requires Upstash rediss:// URL in RATE_LIMIT_REDIS_URL
# RATE_LIMIT_REDIS_URL=rediss://default:TOKEN@HOST:6379
# RATE_LIMIT_REDIS_COMMAND_TIMEOUT_MS=2000

# Task 020 — media storage (default local disk for dev/test; S3-compatible opt-in)
# MEDIA_STORAGE_BACKEND=local
# MEDIA_STORAGE_BACKEND=s3   # private bucket; requires vars below; production activation needs owner approval
# MEDIA_S3_BUCKET=strangeup-prod-media-private
# MEDIA_S3_REGION=auto
# MEDIA_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_S3_KEY_PREFIX=strangeup
# MEDIA_S3_REQUEST_TIMEOUT_MS=10000
# MEDIA_S3_MAX_RETRIES=2
# MEDIA_S3_FORCE_PATH_STYLE=true

# Local upload roots (used when MEDIA_STORAGE_BACKEND=local; forbidden as .data/* in production)
PROFILE_UPLOAD_DIR=.data/profile-media
ACTIVITY_UPLOAD_DIR=.data/activity-media
GROUP_UPLOAD_DIR=.data/group-media
STORE_UPLOAD_DIR=.data/store-media

# Task 016 — group stories, photo post attachments, polls (D-06 owner gate; default off)
# GROUP_COMMUNITY_INTERACTIVE_ENABLED=false
# GROUP_RATE_LIMIT_STORY_PER_USER=20
# GROUP_RATE_LIMIT_MEDIA_PER_USER=40
# GROUP_RATE_LIMIT_REPORT_PER_USER=10

# Task 021 — canonical consent registry (counsel ACTIVE version IDs still pending)
# CONSENT_ENFORCEMENT=placeholder_allowed   # dev/test default behavior via NODE_ENV
# CONSENT_ENFORCEMENT=strict                # production: registration fails until counsel ACTIVE IDs exist
# GET /v1/consents/required — server-owned document/version availability (no legal copy)

# Task 021 — KYC verification (Veriff BLOCKED BY OWNER until KYC-02 approval)
# KYC_PROVIDER_ENABLED=false
# KYC_PROVIDER=none                         # none | mock (integration) | veriff (blocked without owner)
# KYC_MOCK_WEBHOOK_HMAC_SECRET=             # min 32 chars; required when KYC_PROVIDER=mock
# KYC_SESSION_TTL_SECONDS=3600
# KYC_WEBHOOK_BODY_LIMIT_BYTES=65536
# VERIFF_API_KEY=
# VERIFF_SHARED_SECRET=
# VERIFF_API_BASE_URL=https://stationapi.veriff.com
# VERIFF_LIVE_CALLS_ENABLED=false           # must stay false until owner authorizes Veriff sandbox/live

# Socket.IO messaging (Task 023B) — single-instance default; Redis adapter stays off until separately verified
# SOCKET_IO_ENABLED=true
# SOCKET_IO_PATH=/socket.io
# SOCKET_IO_REDIS_ADAPTER_ENABLED=false
# SOCKET_IO_TYPING_MIN_INTERVAL_MS=2000
# SOCKET_IO_TYPING_TTL_MS=5000

# Push (Task 023C/023D) — registration APIs live; FCM send stays off until owner authorizes production delivery
# PUSH_ENABLED=false
# PUSH_WORKER_ENABLED=true
# PUSH_WORKER_INTERVAL_MS=5000
# PUSH_WORKER_BATCH_SIZE=20
# PUSH_MAX_ATTEMPTS=5
# PUSH_RETRY_BASE_MS=2000
# PUSH_OUTBOX_LOCK_TTL_MS=120000
# PUSH_MAX_NOTIFICATION_AGE_SECONDS=86400
# FIREBASE_CREDENTIALS_FILE=/secure/path/firebase-service-account.json
# FIREBASE_PROJECT_ID=

# Socket.IO account eligibility recheck while connected (Task 023D)
# SOCKET_IO_ACCOUNT_RECHECK_INTERVAL_MS=15000

# Store catalog management (Task 024B) — staff APIs; default off; production fail-closed until MKT-01/02
# STORE_CATALOG_MANAGEMENT_ENABLED=false
# PLATFORM_STORE_CATALOG_MANAGER_USER_IDS=   # non-production bootstrap only (comma-separated user UUIDs)

# Integration tests — must be catalog strangeup_test (never strangeup_dev, neondb, or production)
# RUN_INTEGRATION=1
# INTEGRATION_DATABASE_URL=postgresql://USER:PASSWORD@ep-yyyy-pooler.REGION.aws.neon.tech/strangeup_test?sslmode=require
