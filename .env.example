# Copy to `.env` for local development (never commit real secrets).

NODE_ENV=development
PORT=3000

# PostgreSQL connection string (dev). Examples:
# - Local Postgres: postgresql://strangeup:strangeup@localhost:5432/strangeup_dev?schema=public
# - Prisma Dev (`npm run db:dev`): use the DATABASE_URL printed by `prisma dev`
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/strangeup_dev?schema=public

# Comma-separated allowed browser origins (no wildcard when credentials are enabled)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LOG_LEVEL=info
JSON_BODY_LIMIT=100kb
TRUST_PROXY=false

# Auth (Task 002B.1) — generate a strong random secret for non-test environments
JWT_ACCESS_SECRET=change-me-to-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_CHALLENGE_TTL_SECONDS=86400
AUTH_RATE_LIMIT_LOGIN_PER_IP=10
AUTH_RATE_LIMIT_LOGIN_PER_EMAIL=5
AUTH_RATE_LIMIT_REGISTER_PER_IP=10
AUTH_RATE_LIMIT_PASSWORD_RESET_PER_IP=10
AUTH_RATE_LIMIT_PASSWORD_RESET_PER_EMAIL=5
AUTH_RATE_LIMIT_EMAIL_VERIFY_PER_USER=5

# Optional trusted base URL for password-reset links in dev/stub email (never use Host header)
# PUBLIC_APP_BASE_URL=https://app.example.com

# RELEASE BLOCKER: counsel-approved consent document version IDs are not configured server-side yet.
# Clients must send non-empty version strings per consent item until canonical versions are published.

# Integration tests — use a separate Prisma Dev instance (see `npx prisma dev ls` TCP URL)
# RUN_INTEGRATION=1
# INTEGRATION_DATABASE_URL=postgresql://USER:PASSWORD@localhost:PORT/template1?sslmode=disable
