# Task 031J-1 — isolated Manual KYC sandbox API (Neon strangeup_test only).
# Copy to `.env.manual-kyc-test.local` (gitignored). Requires base `.env` with JWT secrets
# and INTEGRATION_DATABASE_URL pointing at strangeup_test (never strangeup_dev).
#
# Start: npm run dev:manual-kyc-test
# Audit: npm run manual-kyc-test:check-config

PORT=3010
MANUAL_KYC_TEST_DATABASE_SOURCE=integration

# Manual KYC authority — Veriff/provider path stays off (code preserved, inactive).
KYC_PROVIDER_ENABLED=false
KYC_PROVIDER=none
KYC_IDENTITY_AUTHORITY=manual
KYC_MANUAL_REVIEW_ENABLED=true
VERIFF_LIVE_CALLS_ENABLED=false

# Cloudinary authenticated evidence (server-only — owner supplies from Cloudinary console).
# Use a dedicated non-production cloud/folder for sandbox smoke tests.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_KYC_EVIDENCE_FOLDER=strangeup/kyc-evidence-sandbox

# Browser origins for Admin sandbox (Vite 5174) and direct API probes.
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010,http://localhost:5174,http://127.0.0.1:5174
