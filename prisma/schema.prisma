// StrangeUp — identity Phase 1 (Task 002B.1). See ADR-004.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum AgeEligibilityStatus {
  UNKNOWN
  ELIGIBLE
  INELIGIBLE
  NEEDS_REVIEW
}

enum IdentityVerificationStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  REVOKED
}

/// StrangeUp platform admin activation (distinct from provider identity APPROVED).
enum StrangeUpAdminReviewStatus {
  NOT_READY
  PENDING
  NEEDS_FURTHER_REVIEW
  APPROVED
  REJECTED
  NEEDS_MORE_INFO
}

enum PlatformStaffRole {
  IDENTITY_REVIEWER
  STORE_CATALOG_MANAGER
  SUPER_ADMIN
}

enum VerificationProvider {
  MOCK
  VERIFF
  MANUAL
}

enum ManualKycEvidenceKind {
  ID_DOCUMENT
  ID_DOCUMENT_BACK
  SELFIE
}

enum ManualIdDocumentType {
  PASSPORT
  NATIONAL_ID
  DRIVERS_LICENSE
  STATE_ID
  OTHER_ONE_SIDED
  OTHER_TWO_SIDED
}

enum VerificationSessionStatus {
  PENDING_USER
  PENDING_PROVIDER
  APPROVED
  DECLINED
  RESUBMISSION_REQUESTED
  IN_REVIEW
  EXPIRED
  ABANDONED
  CANCELLED
}

enum AuthChallengeType {
  EMAIL_VERIFY
  EMAIL_CHANGE
  PASSWORD_RESET
  PHONE_OTP
}

enum ConsentType {
  TERMS
  PRIVACY
  AGE_ATTESTATION
}

enum ProfileVisibility {
  EVERYONE
  VERIFIED_USERS_ONLY
}

enum FavoriteActivitySkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum FavoriteActivityCadence {
  WEEKLY
  CASUAL
}

model User {
  id                         String                     @id @default(uuid()) @db.Uuid
  accountStatus              AccountStatus              @default(PENDING_VERIFICATION)
  email                      String
  emailNormalized            String                     @unique
  phoneE164                  String?                    @unique
  emailVerifiedAt            DateTime?
  phoneVerifiedAt            DateTime?
  ageEligibilityStatus       AgeEligibilityStatus       @default(UNKNOWN)
  identityVerificationStatus IdentityVerificationStatus @default(NOT_STARTED)
  identityVerificationApprovedAt DateTime?
  identityVerificationValidUntil DateTime?
  identityVerificationRevokedAt  DateTime?
  /// Provider session that currently backs identityVerificationStatus (when approved).
  identityVerificationSessionId String?                  @db.Uuid
  identityVerificationSession   VerificationSession?     @relation("UserIdentityVerificationSession", fields: [identityVerificationSessionId], references: [id], onDelete: SetNull)
  adminReviewStatus             StrangeUpAdminReviewStatus @default(NOT_READY)
  adminReviewVerificationSessionId String?               @db.Uuid
  adminReviewVerificationSession   VerificationSession?  @relation("UserAdminReviewSession", fields: [adminReviewVerificationSessionId], references: [id], onDelete: SetNull)
  adminReviewDecidedAt          DateTime?
  suspendedAt                DateTime?
  deletedAt                  DateTime?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  passwordCredential PasswordCredential?
  sessions           Session[]
  authChallenges     AuthChallenge[]
  consentRecords     ConsentRecord[]
  profile            Profile?
  userInterests      UserInterest[]
  favoriteActivities ProfileFavoriteActivity[]
  blocksInitiated    UserBlock[]               @relation("UserBlocksInitiated")
  blocksReceived     UserBlock[]               @relation("UserBlocksReceived")
  hostedActivities   Activity[]
  activityParticipations ActivityParticipation[]
  followsInitiated   UserFollow[]                @relation("UserFollowsInitiated")
  followsReceived    UserFollow[]                @relation("UserFollowsReceived")
  wavesSent          UserWave[]                  @relation("UserWavesSent")
  wavesReceived      UserWave[]                  @relation("UserWavesReceived")
  messageRequestsSent     DirectMessageRequest[] @relation("MessageRequestsSent")
  messageRequestsReceived DirectMessageRequest[] @relation("MessageRequestsReceived")
  meetupInvitesSent       PersonalMeetupInvitation[] @relation("MeetupInviteSender")
  meetupInvitesReceived   PersonalMeetupInvitation[] @relation("MeetupInviteRecipient")
  conversationParticipations DirectConversationParticipant[]
  conversationsAsLow  DirectConversation[]       @relation("ConversationParticipantLow")
  conversationsAsHigh DirectConversation[]       @relation("ConversationParticipantHigh")
  directMessagesAuthored DirectMessage[]
  ownedCommunityGroups           CommunityGroup[]            @relation("CommunityGroupOwner")
  communityMemberships           CommunityMembership[]       @relation("CommunityMembershipUser")
  communityMembershipsApproved   CommunityMembership[]       @relation("CommunityMembershipApprover")
  communityPostsAuthored         CommunityPost[]             @relation("CommunityPostAuthor")
  communityPostsPinned           CommunityPost[]             @relation("CommunityPostPinnedBy")
  communityPostsRemoved          CommunityPost[]             @relation("CommunityPostRemovedBy")
  communityPostCommentsAuthored  CommunityPostComment[]      @relation("CommunityPostCommentAuthor")
  communityPostCommentsRemoved   CommunityPostComment[]      @relation("CommunityPostCommentRemovedBy")
  communityPostLikes             CommunityPostLike[]
  communityGroupMessagesAuthored CommunityGroupMessage[]
  communityGroupReadStates       CommunityGroupReadState[]
  communityGroupActivitiesAttached CommunityGroupActivity[]  @relation("CommunityGroupActivityAttacher")
  notificationsReceived          UserNotification[]          @relation("UserNotificationsReceived")
  notificationsAsActor           UserNotification[]          @relation("UserNotificationsActor")
  storeFavorites                 StoreFavorite[]
  storeCartItems                 StoreCartItem[]
  jobListingsAuthored            JobListing[]                @relation("JobListingAuthor")
  savedJobs                      SavedJob[]
  jobApplications                JobApplication[]
  savedActivities                SavedActivity[]
  communityGroupMediaAuthored    CommunityGroupMedia[]       @relation("CommunityGroupMediaAuthor")
  communityStoriesAuthored       CommunityGroupStory[]       @relation("CommunityGroupStoryAuthor")
  communityStoriesRemoved        CommunityGroupStory[]       @relation("CommunityGroupStoryRemovedBy")
  communityPollsAuthored         CommunityPoll[]             @relation("CommunityPollAuthor")
  communityPollVotes             CommunityPollVote[]
  communityContentReportsFiled   CommunityContentReport[]    @relation("CommunityContentReportReporter")
  communityContentReportsReviewed CommunityContentReport[]   @relation("CommunityContentReportReviewer")
  verificationSessions            VerificationSession[]
  manualVerificationEvidence      ManualVerificationEvidence[]
  adminReviewDecisions            IdentityAdminReviewDecision[] @relation("IdentityAdminReviewSubject")
  identityAdminReviewNotes        IdentityAdminReviewInternalNote[] @relation("IdentityAdminReviewNoteSubject")
  identityAdminReviewNotesAuthored IdentityAdminReviewInternalNote[] @relation("IdentityAdminReviewNoteAuthor")
  identityAdminReviewNotesRedacted IdentityAdminReviewInternalNote[] @relation("IdentityAdminReviewNoteRedactedBy")
  identityAdminReviewIdempotencyReservations IdentityAdminReviewIdempotencyReservation[] @relation("IdentityAdminReviewIdempotencyReviewer")
  platformStaffGrants             PlatformStaffGrant[]
  accountModerationDecisionsAsSubject AccountModerationDecision[] @relation("AccountModerationSubject")
  accountModerationDecisionsAsActor   AccountModerationDecision[] @relation("AccountModerationActor")
  activityModerationDecisionsAsActor  ActivityModerationDecision[] @relation("ActivityModerationActor")
  deviceTokens                    UserDeviceToken[]
  notificationPreference          UserNotificationPreference?
  pushOutboxEntries               PushNotificationOutbox[]

  @@index([accountStatus])
  @@index([adminReviewStatus])
}

enum DevicePlatform {
  ANDROID
  IOS
}

/// FCM registration token storage (Task 023C). Raw token never returned by HTTP APIs.
model UserDeviceToken {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @db.Uuid
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform          DevicePlatform
  tokenSha256       String         @unique
  registrationToken String
  deviceBindingId   String         @db.VarChar(128)
  sessionId         String?        @db.Uuid
  session           Session?       @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  revokedAt         DateTime?
  lastSeenAt        DateTime       @default(now())
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([userId, deviceBindingId])
  @@index([userId, revokedAt])
  @@index([sessionId])
}

/// Per-user push category toggles (Task 023C). FCM delivery remains gated until Task 023D.
model UserNotificationPreference {
  userId                   String   @id @db.Uuid
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushEnabled              Boolean  @default(true)
  directMessagesEnabled    Boolean  @default(true)
  messageRequestsEnabled   Boolean  @default(true)
  groupMembershipEnabled   Boolean  @default(true)
  groupChatEnabled         Boolean  @default(false)
  activityUpdatesEnabled   Boolean  @default(true)
  meetupInvitesEnabled     Boolean  @default(true)
  marketingEnabled         Boolean  @default(false)
  updatedAt                DateTime @updatedAt
}

model PlatformStaffGrant {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @db.Uuid
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            PlatformStaffRole
  grantedAt       DateTime          @default(now())
  grantedByUserId String?           @db.Uuid
  revokedAt       DateTime?

  @@unique([userId, role])
  @@index([role, revokedAt])
}

enum AccountModerationAction {
  SUSPEND
  RESTORE
}

/// Super-admin account suspend/restore audit (Task 032C). Distinct from identity review decisions.
model AccountModerationDecision {
  id                     String                   @id @default(uuid()) @db.Uuid
  userId                 String                   @db.Uuid
  user                   User                     @relation("AccountModerationSubject", fields: [userId], references: [id], onDelete: Cascade)
  actorUserId            String                   @db.Uuid
  actor                  User                     @relation("AccountModerationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  action                 AccountModerationAction
  reasonCode             String                   @db.VarChar(64)
  reason                 String                   @db.VarChar(500)
  previousAccountStatus  AccountStatus
  resultingAccountStatus AccountStatus
  idempotencyKey         String?                  @unique
  createdAt              DateTime                 @default(now())

  @@index([userId, createdAt])
  @@index([actorUserId, createdAt])
}

enum ActivityModerationAction {
  CANCEL
}

/// Super-admin activity cancel audit (Task 033D). Distinct from host self-service cancel.
model ActivityModerationDecision {
  id                      String                    @id @default(uuid()) @db.Uuid
  activityId              String                    @db.Uuid
  activity                Activity                  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  actorUserId             String                    @db.Uuid
  actor                   User                      @relation("ActivityModerationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  action                  ActivityModerationAction
  reasonCode              String                    @db.VarChar(64)
  reason                  String                    @db.VarChar(500)
  previousActivityStatus  ActivityStatus
  resultingActivityStatus ActivityStatus
  confirmedClosedCount    Int
  waitlistedClosedCount   Int
  pendingClosedCount      Int
  idempotencyKey          String?                   @unique
  createdAt               DateTime                  @default(now())

  @@index([activityId, createdAt])
  @@index([actorUserId, createdAt])
}

enum UserNotificationType {
  MESSAGE_REQUEST_RECEIVED
  MESSAGE_REQUEST_ACCEPTED
  DIRECT_MESSAGE_RECEIVED
  GROUP_MEMBERSHIP_APPROVED
  GROUP_MEMBERSHIP_DECLINED
  ACTIVITY_RSVP_CONFIRMED
  ACTIVITY_RSVP_WAITLISTED
  ACTIVITY_WAITLIST_PROMOTED
  ACTIVITY_JOIN_REQUEST_RECEIVED
  ACTIVITY_JOIN_REQUEST_APPROVED
  ACTIVITY_JOIN_REQUEST_DECLINED
  MEETUP_INVITATION_RECEIVED
  MEETUP_INVITATION_ACCEPTED
  MEETUP_INVITATION_DECLINED
  MEETUP_INVITATION_WITHDRAWN
}

enum PushOutboxStatus {
  PENDING
  PROCESSING
  SENT
  SKIPPED
  FAILED
}

model UserNotification {
  id          String               @id @default(uuid()) @db.Uuid
  recipientId String               @db.Uuid
  recipient   User                 @relation("UserNotificationsReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  type        UserNotificationType
  actorUserId String?              @db.Uuid
  actor       User?                @relation("UserNotificationsActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  sourceId    String?              @db.Uuid
  title       String
  body        String
  dedupeKey   String?              @unique
  readAt      DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  pushOutbox  PushNotificationOutbox?

  @@index([recipientId, readAt, createdAt, id])
  @@index([recipientId, createdAt, id])
}

/// Durable FCM delivery queue (Task 023D). One row per persisted UserNotification.
model PushNotificationOutbox {
  id                 String           @id @default(uuid()) @db.Uuid
  userNotificationId String           @unique @db.Uuid
  userNotification   UserNotification @relation(fields: [userNotificationId], references: [id], onDelete: Cascade)
  recipientId        String           @db.Uuid
  recipient          User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  status             PushOutboxStatus @default(PENDING)
  attemptCount       Int              @default(0)
  nextAttemptAt      DateTime         @default(now())
  lockedAt           DateTime?
  lockedBy           String?
  lastErrorCode      String?
  lastErrorMessage   String?
  sentAt             DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([status, nextAttemptAt])
  @@index([recipientId])
}

model PasswordCredential {
  userId            String   @id @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash      String
  passwordChangedAt DateTime @default(now())
  mustReauthAfter   DateTime?
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId         String    @db.Uuid
  refreshTokenHash         String
  previousRefreshTokenHash String?
  expiresAt                DateTime
  revokedAt        DateTime?
  userAgent        String?
  ipHash           String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deviceTokens     UserDeviceToken[]

  @@index([userId])
  @@index([familyId])
  @@index([refreshTokenHash])
}

model AuthChallenge {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String?           @db.Uuid
  user         User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         AuthChallengeType
  target       String
  secretHash   String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int               @default(0)
  createdAt    DateTime          @default(now())

  @@index([type, target])
  @@index([userId, type])
}

model ConsentRecord {
  id                String      @id @default(uuid()) @db.Uuid
  userId            String      @db.Uuid
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentType       ConsentType
  documentId        String?
  documentVersion   String
  acceptanceContext String      @default("REGISTRATION")
  recordedAt        DateTime    @default(now())
  ipHash            String?

  @@index([userId])
  @@index([userId, consentType, documentVersion])
}

model Profile {
  userId            String             @id @db.Uuid
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName         String?
  lastName          String?
  displayName       String?
  username          String?
  bio               String?
  birthDate         DateTime           @db.Date
  scheduleTimeZone  String?
  profileVisibility ProfileVisibility  @default(VERIFIED_USERS_ONLY)
  locationCity      String?
  locationRegion    String?
  avatarStorageKey  String?
  avatarContentType String?
  avatarUpdatedAt   DateTime?
}

model ProfileFavoriteActivity {
  id            String                   @id @default(uuid()) @db.Uuid
  userId        String                   @db.Uuid
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sortOrder     Int
  title         String
  skillLevel    FavoriteActivitySkillLevel
  cadence       FavoriteActivityCadence
  scheduleNote  String?
  placeLabel    String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@unique([userId, sortOrder])
  @@index([userId])
}

model Interest {
  id        String         @id @db.Uuid
  slug      String         @unique
  label     String
  sortOrder Int
  selections UserInterest[]
}

model UserInterest {
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interestId String   @db.Uuid
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, interestId])
  @@index([interestId])
}

model UserBlock {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  blocker   User     @relation("UserBlocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("UserBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model RegisterIdempotency {
  id           String   @id
  requestHash  String
  responseJson String
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
}

enum ActivityMode {
  IN_PERSON
  VIRTUAL
  HYBRID
}

enum ActivityStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum ActivityAudience {
  PUBLIC
  FOLLOWERS_ONLY
}

enum ActivityJoinMode {
  AUTO
  HOST_APPROVAL
}

enum ActivityParticipationState {
  CONFIRMED
  WAITLISTED
  PENDING
  DECLINED
  CANCELLED
}

model ActivityCategory {
  id         String     @id @db.Uuid
  slug       String     @unique
  label      String
  sortOrder  Int
  activities Activity[]
}

model Activity {
  id                    String           @id @default(uuid()) @db.Uuid
  hostId                String           @db.Uuid
  host                  User             @relation(fields: [hostId], references: [id], onDelete: Cascade)
  title                 String
  description           String?
  categoryId            String           @db.Uuid
  category              ActivityCategory @relation(fields: [categoryId], references: [id])
  coverStorageKey       String?
  coverContentType      String?
  startsAt              DateTime
  endsAt                DateTime
  timeZone              String
  mode                  ActivityMode
  status                ActivityStatus   @default(DRAFT)
  audience              ActivityAudience @default(PUBLIC)
  venueName             String?
  locationCity          String?
  locationRegion        String?
  meetingInstructions   String?
  virtualMeetingDetails String?
  skillNotes            String?
  gearNotes             String?
  capacity              Int
  waitlistEnabled       Boolean          @default(false)
  joinMode              ActivityJoinMode @default(AUTO)
  publishedAt           DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  participations ActivityParticipation[]
  communityGroupLinks CommunityGroupActivity[]
  communityPosts      CommunityPost[]
  savedBy               SavedActivity[]
  moderationDecisions ActivityModerationDecision[]

  @@index([status, audience, startsAt])
  @@index([categoryId, status, startsAt])
  @@index([hostId, status])
  @@index([locationCity, locationRegion])
}

model ActivityParticipation {
  id               String                      @id @default(uuid()) @db.Uuid
  activityId       String                      @db.Uuid
  activity         Activity                    @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId           String                      @db.Uuid
  user             User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  state            ActivityParticipationState
  waitlistPosition Int?
  hostApprovedAt   DateTime?
  joinedAt         DateTime                    @default(now())
  cancelledAt      DateTime?
  updatedAt        DateTime                    @updatedAt

  @@unique([activityId, userId])
  @@index([userId, state])
  @@index([activityId, state, waitlistPosition])
}

model SavedActivity {
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId String   @db.Uuid
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, activityId])
  @@index([userId, createdAt, activityId])
}

enum DirectMessageRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model UserFollow {
  followerId  String   @db.Uuid
  followingId String   @db.Uuid
  follower    User     @relation("UserFollowsInitiated", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowsReceived", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followingId, createdAt])
}

model UserWave {
  id          String   @id @default(uuid()) @db.Uuid
  senderId    String   @db.Uuid
  recipientId String   @db.Uuid
  sender      User     @relation("UserWavesSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User     @relation("UserWavesReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([senderId, recipientId])
  @@index([recipientId, createdAt])
}

model DirectMessageRequest {
  id             String                      @id @default(uuid()) @db.Uuid
  senderId       String                      @db.Uuid
  recipientId    String                      @db.Uuid
  sender         User                        @relation("MessageRequestsSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient      User                        @relation("MessageRequestsReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  status         DirectMessageRequestStatus  @default(PENDING)
  conversationId String?                     @db.Uuid
  conversation   DirectConversation?         @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  respondedAt    DateTime?

  @@unique([senderId, recipientId])
  @@index([recipientId, status, createdAt])
  @@index([senderId, status, createdAt])
}

/// Direct 1:1 meetup invitation (Task 028C). Independent of Activity RSVP / host approval (D-09).
enum PersonalMeetupInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

enum PersonalMeetupInviteType {
  COFFEE
  ACTIVITY
  SPORTS
  OTHER
}

model PersonalMeetupInvitation {
  id                   String                     @id @default(uuid()) @db.Uuid
  senderId             String                     @db.Uuid
  sender               User                       @relation("MeetupInviteSender", fields: [senderId], references: [id], onDelete: Restrict)
  recipientId          String                     @db.Uuid
  recipient            User                       @relation("MeetupInviteRecipient", fields: [recipientId], references: [id], onDelete: Restrict)

  status               PersonalMeetupInviteStatus
  meetupType           PersonalMeetupInviteType
  title                String
  scheduledStartsAt    DateTime
  scheduleTimeZone     String

  venueCity            String
  venueRegion          String
  venueLabel           String?
  venueAddressLine     String?
  venuePlaceNotes      String?

  note                 String?

  createIdempotencyKey String?                    @unique

  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  acceptedAt           DateTime?
  declinedAt           DateTime?
  withdrawnAt          DateTime?
  expiredAt            DateTime?

  @@index([recipientId, status, createdAt, id])
  @@index([senderId, status, createdAt, id])
  @@index([scheduledStartsAt])
}

model DirectConversation {
  id                String   @id @default(uuid()) @db.Uuid
  participantLowId  String   @db.Uuid
  participantHighId String   @db.Uuid
  participantLow    User     @relation("ConversationParticipantLow", fields: [participantLowId], references: [id], onDelete: Cascade)
  participantHigh   User     @relation("ConversationParticipantHigh", fields: [participantHighId], references: [id], onDelete: Cascade)
  lastMessageId     String?  @db.Uuid
  lastMessageAt     DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  participants DirectConversationParticipant[]
  messages     DirectMessage[]
  requests     DirectMessageRequest[]

  @@unique([participantLowId, participantHighId])
  @@index([updatedAt, id])
}

model DirectConversationParticipant {
  conversationId    String    @db.Uuid
  userId            String    @db.Uuid
  conversation      DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadMessageId String?   @db.Uuid
  lastReadAt        DateTime?
  joinedAt          DateTime  @default(now())

  @@id([conversationId, userId])
  @@index([userId])
}

model DirectMessage {
  id             String             @id @default(uuid()) @db.Uuid
  conversationId String             @db.Uuid
  conversation   DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String             @db.Uuid
  author         User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body           String
  clientMessageId String?
  createdAt      DateTime           @default(now())

  @@unique([conversationId, authorId, clientMessageId])
  @@index([conversationId, createdAt, id])
}

enum CommunityGroupPrivacy {
  PUBLIC
  PRIVATE_APPROVAL
}

enum CommunityGroupStatus {
  ACTIVE
  ARCHIVED
}

enum CommunityGroupMeetupFrequency {
  WEEKLY
  ACTIVE_DAILY
  BIWEEKLY
}

enum CommunityMembershipRole {
  OWNER
  MODERATOR
  MEMBER
}

enum CommunityMembershipStatus {
  PENDING
  ACTIVE
  DECLINED
  REMOVED
  LEFT
}

enum CommunityPostModerationState {
  VISIBLE
  REMOVED
}

model CommunityGroupCategory {
  id        String           @id @db.Uuid
  slug      String           @unique
  label     String
  sortOrder Int
  groups    CommunityGroup[]
}

model CommunityGroup {
  id               String                         @id @default(uuid()) @db.Uuid
  ownerId          String                         @db.Uuid
  owner            User                           @relation("CommunityGroupOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  name             String
  description      String?
  categoryId       String                         @db.Uuid
  category         CommunityGroupCategory         @relation(fields: [categoryId], references: [id])
  locationCity     String?
  locationRegion   String?
  privacy          CommunityGroupPrivacy
  meetupFrequency  CommunityGroupMeetupFrequency?
  memberCapacity   Int?
  status           CommunityGroupStatus           @default(ACTIVE)
  coverStorageKey  String?
  coverContentType String?
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt

  tags         CommunityGroupTag[]
  memberships  CommunityMembership[]
  posts        CommunityPost[]
  messages     CommunityGroupMessage[]
  readStates   CommunityGroupReadState[]
  activities   CommunityGroupActivity[]
  groupMedia   CommunityGroupMedia[]
  stories      CommunityGroupStory[]
  polls        CommunityPoll[]
  contentReports CommunityContentReport[]

  @@index([status, privacy, createdAt])
  @@index([categoryId, status])
  @@index([locationCity, locationRegion])
  @@index([ownerId, status])
}

model CommunityGroupTag {
  groupId String         @db.Uuid
  group   CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tag     String

  @@id([groupId, tag])
  @@index([tag])
}

model CommunityMembership {
  id          String                     @id @default(uuid()) @db.Uuid
  groupId     String                     @db.Uuid
  group       CommunityGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId      String                     @db.Uuid
  user        User                       @relation("CommunityMembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  role        CommunityMembershipRole
  status      CommunityMembershipStatus
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  respondedAt DateTime?
  approverId  String?                    @db.Uuid
  approver    User?                      @relation("CommunityMembershipApprover", fields: [approverId], references: [id], onDelete: SetNull)

  @@unique([groupId, userId])
  @@index([groupId, status])
  @@index([userId, status])
}

model CommunityPost {
  id           String                       @id @default(uuid()) @db.Uuid
  groupId      String                       @db.Uuid
  group        CommunityGroup               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId     String                       @db.Uuid
  author       User                         @relation("CommunityPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body         String
  activityId   String?                      @db.Uuid
  activity     Activity?                    @relation(fields: [activityId], references: [id], onDelete: SetNull)
  pinnedAt     DateTime?
  pinnedById   String?                      @db.Uuid
  pinnedBy     User?                        @relation("CommunityPostPinnedBy", fields: [pinnedById], references: [id], onDelete: SetNull)
  moderation   CommunityPostModerationState @default(VISIBLE)
  removedAt    DateTime?
  removedById  String?                      @db.Uuid
  removedBy    User?                        @relation("CommunityPostRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  comments CommunityPostComment[]
  likes    CommunityPostLike[]
  photoMedia CommunityGroupMedia?
  poll       CommunityPoll?

  @@index([groupId, moderation, pinnedAt, createdAt])
  @@index([authorId, createdAt])
}

enum CommunityGroupMediaKind {
  POST_ATTACHMENT
  STORY
}

enum CommunityGroupMediaLifecycle {
  ACTIVE
  REMOVED
}

model CommunityGroupMedia {
  id          String                       @id @default(uuid()) @db.Uuid
  groupId     String                       @db.Uuid
  group       CommunityGroup               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  kind        CommunityGroupMediaKind
  lifecycle   CommunityGroupMediaLifecycle @default(ACTIVE)
  storageKey  String
  contentType String
  byteSize    Int
  authorId    String                       @db.Uuid
  author      User                         @relation("CommunityGroupMediaAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  postId      String?                      @unique @db.Uuid
  post        CommunityPost?               @relation(fields: [postId], references: [id], onDelete: SetNull)
  story       CommunityGroupStory?
  createdAt   DateTime                     @default(now())
  removedAt   DateTime?
  expiresAt   DateTime?

  @@index([groupId, kind, lifecycle, expiresAt])
}

model CommunityGroupStory {
  id          String                       @id @default(uuid()) @db.Uuid
  groupId     String                       @db.Uuid
  group       CommunityGroup               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId    String                       @db.Uuid
  author      User                         @relation("CommunityGroupStoryAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  mediaId     String                       @unique @db.Uuid
  media       CommunityGroupMedia          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  moderation  CommunityPostModerationState @default(VISIBLE)
  removedAt   DateTime?
  removedById String?                      @db.Uuid
  removedBy   User?                        @relation("CommunityGroupStoryRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)
  createdAt   DateTime                     @default(now())
  expiresAt   DateTime

  @@index([groupId, moderation, expiresAt, createdAt])
}

model CommunityPoll {
  id        String         @id @default(uuid()) @db.Uuid
  postId    String         @unique @db.Uuid
  post      CommunityPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  groupId   String         @db.Uuid
  group     CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId  String         @db.Uuid
  author    User           @relation("CommunityPollAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  closesAt  DateTime
  createdAt DateTime       @default(now())

  options CommunityPollOption[]
  votes   CommunityPollVote[]

  @@index([groupId])
}

model CommunityPollOption {
  id        String        @id @default(uuid()) @db.Uuid
  pollId    String        @db.Uuid
  poll      CommunityPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  sortOrder Int
  label     String

  votes CommunityPollVote[]

  @@unique([pollId, sortOrder])
  @@index([pollId])
}

model CommunityPollVote {
  pollId    String              @db.Uuid
  poll      CommunityPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId    String              @db.Uuid
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  optionId  String              @db.Uuid
  option    CommunityPollOption @relation(fields: [optionId], references: [id], onDelete: Restrict)
  createdAt DateTime            @default(now())

  @@id([pollId, userId])
  @@index([pollId, optionId])
}

enum CommunityContentReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE_MEDIA
  OTHER
}

enum CommunityContentReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum CommunityContentReportTargetType {
  POST
  STORY
  POST_MEDIA
}

model CommunityContentReport {
  id           String                           @id @default(uuid()) @db.Uuid
  groupId      String                           @db.Uuid
  group        CommunityGroup                   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  reporterId   String                           @db.Uuid
  reporter     User                             @relation("CommunityContentReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType   CommunityContentReportTargetType
  targetId     String                           @db.Uuid
  reason       CommunityContentReportReason
  detail       String?
  status       CommunityContentReportStatus     @default(OPEN)
  createdAt    DateTime                         @default(now())
  reviewedAt   DateTime?
  reviewedById String?                          @db.Uuid
  reviewedBy   User?                            @relation("CommunityContentReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([reporterId, targetType, targetId])
  @@index([groupId, status, createdAt])
}

model CommunityPostComment {
  id          String        @id @default(uuid()) @db.Uuid
  postId      String        @db.Uuid
  post        CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId    String        @db.Uuid
  author      User          @relation("CommunityPostCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body        String
  removedAt   DateTime?
  removedById String?       @db.Uuid
  removedBy   User?         @relation("CommunityPostCommentRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([postId, createdAt])
}

model CommunityPostLike {
  postId    String        @db.Uuid
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String        @db.Uuid
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([postId, userId])
}

model CommunityGroupMessage {
  id              String         @id @default(uuid()) @db.Uuid
  groupId         String         @db.Uuid
  group           CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId        String         @db.Uuid
  author          User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body            String
  clientMessageId String?
  createdAt       DateTime       @default(now())

  @@unique([groupId, authorId, clientMessageId])
  @@index([groupId, createdAt, id])
}

model CommunityGroupReadState {
  groupId           String         @db.Uuid
  group             CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId            String         @db.Uuid
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadMessageId String?        @db.Uuid
  lastReadAt        DateTime?

  @@id([groupId, userId])
  @@index([userId])
}

model CommunityGroupActivity {
  groupId      String         @db.Uuid
  group        CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  activityId   String         @db.Uuid
  activity     Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  attachedById String         @db.Uuid
  attachedBy   User           @relation("CommunityGroupActivityAttacher", fields: [attachedById], references: [id], onDelete: Restrict)
  attachedAt   DateTime       @default(now())

  @@id([groupId, activityId])
  @@index([activityId])
}

enum StoreProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum JobListingStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum JobWorkMode {
  ONSITE
  REMOTE
  HYBRID
}

enum JobEmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  PER_SESSION
}

enum JobPayPeriod {
  HOURLY
  ANNUAL
  PER_SESSION
}

enum JobApplicationStatus {
  SUBMITTED
  IN_REVIEW
  WITHDRAWN
  DECLINED
  ACCEPTED
}

model StoreCategory {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  label     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products StoreProduct[]

  @@index([isActive, sortOrder])
}

model StoreProduct {
  id          String             @id @default(uuid()) @db.Uuid
  slug        String             @unique
  title       String
  description String
  categoryId  String             @db.Uuid
  category    StoreCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status      StoreProductStatus @default(DRAFT)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  variants StoreProductVariant[]
  images   StoreProductImage[]
  favorites StoreFavorite[]

  @@index([status, categoryId, createdAt, id])
  @@index([status, createdAt, id])
}

model StoreProductVariant {
  id                 String   @id @default(uuid()) @db.Uuid
  productId          String   @db.Uuid
  product            StoreProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                String   @unique
  sizeLabel          String?
  colorLabel         String?
  priceCents         Int
  compareAtPriceCents Int?
  currency           String   @default("USD")
  stockQuantity      Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cartItems StoreCartItem[]

  @@index([productId, isActive])
  @@index([productId, sizeLabel, colorLabel])
}

model StoreProductImage {
  id           String       @id @default(uuid()) @db.Uuid
  productId    String       @db.Uuid
  product      StoreProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  storageKey   String
  contentType  String
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())

  @@index([productId, sortOrder])
}

model StoreFavorite {
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String       @db.Uuid
  product   StoreProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@id([userId, productId])
  @@index([userId, createdAt])
}

model StoreCartItem {
  userId    String              @db.Uuid
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId String              @db.Uuid
  variant   StoreProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@id([userId, variantId])
  @@index([userId])
}

model JobListing {
  id                 String             @id @default(uuid()) @db.Uuid
  authorUserId       String?            @db.Uuid
  author             User?              @relation("JobListingAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  title              String
  description        String
  companyDisplayName String
  locationCity       String?
  locationRegion     String?
  workMode           JobWorkMode?
  employmentType     JobEmploymentType
  payMinCents        Int?
  payMaxCents        Int?
  payCurrency        String?
  payPeriod          JobPayPeriod?
  status             JobListingStatus   @default(DRAFT)
  publishedAt        DateTime?
  closedAt           DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  savedBy      SavedJob[]
  applications JobApplication[]

  @@index([status, createdAt, id])
  @@index([authorUserId, status])
  @@index([status, employmentType])
}

model SavedJob {
  userId       String     @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobListingId String     @db.Uuid
  jobListing   JobListing @relation(fields: [jobListingId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([userId, jobListingId])
  @@index([userId, createdAt])
}

model JobApplication {
  id                      String               @id @default(uuid()) @db.Uuid
  jobListingId            String               @db.Uuid
  jobListing              JobListing           @relation(fields: [jobListingId], references: [id], onDelete: Cascade)
  applicantUserId         String               @db.Uuid
  applicant               User                 @relation(fields: [applicantUserId], references: [id], onDelete: Cascade)
  coverMessage            String
  applicationConsentVersion String
  status                  JobApplicationStatus @default(SUBMITTED)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@unique([jobListingId, applicantUserId])
  @@index([applicantUserId, createdAt, id])
}

model IdentityAdminReviewDecision {
  id                   String                     @id @default(uuid()) @db.Uuid
  userId               String                     @db.Uuid
  user                 User                       @relation("IdentityAdminReviewSubject", fields: [userId], references: [id], onDelete: Cascade)
  verificationSessionId String                    @db.Uuid
  verificationSession  VerificationSession        @relation(fields: [verificationSessionId], references: [id], onDelete: Cascade)
  status               StrangeUpAdminReviewStatus
  reasonCode           String?
  reviewerUserId       String?                    @db.Uuid
  idempotencyKey       String?                    @unique
  createdAt            DateTime                   @default(now())
  idempotencyReservation IdentityAdminReviewIdempotencyReservation?

  @@index([userId, createdAt])
  @@index([verificationSessionId, createdAt])
}

/// Atomic per-reviewer client idempotency claim for admin review mutations (Task 031F-1B.2).
model IdentityAdminReviewIdempotencyReservation {
  id                        String                      @id @default(uuid()) @db.Uuid
  reviewerUserId            String                      @db.Uuid
  reviewer                  User                        @relation("IdentityAdminReviewIdempotencyReviewer", fields: [reviewerUserId], references: [id], onDelete: Cascade)
  clientKeyDigest           String                      @db.VarChar(64)
  reviewId                  String                      @db.Uuid
  action                    String                      @db.VarChar(40)
  payloadFingerprint        String                      @db.VarChar(64)
  scopedDecisionKey         String                      @unique
  decisionId                String?                     @unique @db.Uuid
  decision                  IdentityAdminReviewDecision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  responseReviewId          String                      @db.Uuid
  responseAdminReviewStatus StrangeUpAdminReviewStatus?
  createdAt                 DateTime                    @default(now())

  @@unique([reviewerUserId, clientKeyDigest])
  @@index([reviewId, createdAt])
}

/// Staff-only internal notes on an identity review (Task 031F-1). Never exposed on public/Flutter APIs.
model IdentityAdminReviewInternalNote {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation("IdentityAdminReviewNoteSubject", fields: [userId], references: [id], onDelete: Cascade)
  authorUserId     String    @db.Uuid
  author           User      @relation("IdentityAdminReviewNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  body             String    @db.VarChar(2000)
  createdAt        DateTime  @default(now())
  redactedAt       DateTime?
  redactedByUserId String?   @db.Uuid
  redactedBy       User?     @relation("IdentityAdminReviewNoteRedactedBy", fields: [redactedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
}

model VerificationSession {
  id                 String                    @id @default(uuid()) @db.Uuid
  userId             String                    @db.Uuid
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider           VerificationProvider
  providerSessionRef String
  providerAttemptRef String?
  status             VerificationSessionStatus @default(PENDING_USER)
  /** Applicant-declared ID document class for MANUAL provider sessions only. */
  manualIdDocumentType ManualIdDocumentType?
  /** When document type requires explicit rear-side declaration (license/state/national ID). */
  manualIdDocumentHasRearSide Boolean?
  authoritySequence  BigInt                    @default(0)
  sessionExpiresAt   DateTime
  completedAt        DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  decisions VerificationDecision[]
  identityBindingForUsers User[] @relation("UserIdentityVerificationSession")
  adminReviewBindingForUsers User[] @relation("UserAdminReviewSession")
  adminReviewDecisions IdentityAdminReviewDecision[]
  manualVerificationEvidence ManualVerificationEvidence[]

  @@unique([provider, providerSessionRef])
  @@index([userId, createdAt])
  @@index([userId, status])
}

model ManualVerificationEvidence {
  id                    String                @id @default(uuid()) @db.Uuid
  userId                String                @db.Uuid
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationSessionId String                @db.Uuid
  verificationSession   VerificationSession   @relation(fields: [verificationSessionId], references: [id], onDelete: Cascade)
  kind                  ManualKycEvidenceKind
  cloudinaryPublicId    String
  contentType           String
  byteSize              Int
  createdAt             DateTime              @default(now())
  deletedAt             DateTime?

  @@unique([verificationSessionId, kind])
  @@index([userId, createdAt])
}

model VerificationDecision {
  id               String              @id @default(uuid()) @db.Uuid
  sessionId        String              @db.Uuid
  session          VerificationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  providerEventId  String
  decisionStatus   VerificationSessionStatus
  decisionAt       DateTime
  authoritySequence BigInt
  createdAt        DateTime            @default(now())

  @@unique([sessionId, providerEventId])
  @@index([sessionId, authoritySequence])
}

model VerificationWebhookReceipt {
  id              String               @id @default(uuid()) @db.Uuid
  provider        VerificationProvider
  providerEventId String
  sessionId       String?              @db.Uuid
  receivedAt      DateTime             @default(now())

  @@unique([provider, providerEventId])
}
