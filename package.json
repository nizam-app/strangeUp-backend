{
  "name": "strangeup-backend",
  "version": "0.1.0",
  "private": true,
  "description": "StrangeUp backend API (modular monolith foundation)",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:dev": "prisma dev",
    "db:neon:prepare": "tsx scripts/neon-prepare-databases.ts",
    "db:neon:migrate": "tsx scripts/apply-migrations-neon.ts",
    "db:neon:health": "tsx scripts/neon-health-check.ts"
  },
  "keywords": [],
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "multer": "^2.5.0",
    "pg": "^8.16.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sharp": "^0.34.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
